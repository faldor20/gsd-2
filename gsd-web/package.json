{
  "name": "gsd-web",
  "version": "1.0.0",
  "description": "Svelte frontend for the GSD multi-instance web manager",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "bun ./scripts/dev.ts",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "server": "bun --watch server/src/index.ts",
    "preview": "bun run build && bun ./scripts/preview.ts",
    "lint": "eslint .",
    "serve": "vite preview --host 0.0.0.0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "MIT",
  "devDependencies": {
    "@elysiajs/eden": "latest",
    "@eslint/js": "^9.23.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.3",
    "@tailwindcss/vite": "^4.1.12",
    "@types/bun": "latest",
    "@types/node": "latest",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^3.11.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.25.12",
    "svelte-check": "^4.1.5",
    "svelte-eslint-parser": "^1.1.3",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.28.0",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@gsd/web-protocol": "file:../packages/gsd-web-protocol",
    "elysia": "latest"
  }
}
